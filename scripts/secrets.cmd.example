@echo off
REM Copy this file to dist\data\secrets.cmd ONLY for the boot-time knobs that don't have
REM a dashboard surface yet — everything else (public URL, OAuth client IDs, alert floor,
REM retention, OIDC, SMTP creds, etc.) lives in Settings → Public exposure / Code-host
REM OAuth / Alerts / API / Auto-fix and is persisted to Shield's encrypted store.

REM === Production env switch (boot-time, not a user pref) ===
REM Requires a master key — keys at data\keys\ become wrapped under this 32-byte base64 value.
REM set DOTNET_ENVIRONMENT=Production
REM set Shield__Auth__DataProtectionMasterKey=base64-32-byte-value-here

REM === Port (boot-time; the listener binds before the dashboard is reachable) ===
REM set SHIELD_PORT=9000

REM === Skip the launcher's auto-browser-open (useful for headless / service runs) ===
REM set Shield__Launcher__OpenBrowser=false
