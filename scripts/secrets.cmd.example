@echo off
REM Copy this file to dist\data\secrets.cmd and fill in the values. The launcher picks
REM it up automatically on the next run. Only the lines you actually need to set should
REM be present — everything else falls back to the defaults baked into appsettings.json.

REM === GitHub Advisory DB ===
REM Without a PAT, GHSA is capped at 60 requests/hour and the feed effectively never syncs.
REM Create a token at https://github.com/settings/tokens (classic) with NO scopes — the
REM public advisory data doesn't require any. Or a fine-grained token with read:packages.
REM set Shield__Feeds__Ghsa__Pat=ghp_yourPersonalAccessTokenHere

REM === Optional channel credentials ===
REM SMTP password (if you wire an email channel):
REM set Shield__Channels__Smtp__Password=...

REM Discord webhook URL is per-channel, configured via the SPA — not here.

REM === Optional production overrides ===
REM Switch to Production env (requires a master key — keys at data\keys\ become wrapped):
REM set DOTNET_ENVIRONMENT=Production
REM set Shield__Auth__DataProtectionMasterKey=base64-32-byte-value-here

REM Override the port (default 8842):
REM set SHIELD_PORT=9000

REM Open the browser on your public/proxied URL instead of localhost after Shield is
REM listening. Skip the override entirely to fall back to http://localhost:<SHIELD_PORT>.
REM set Shield__Launcher__Url=https://shield.example.com

REM Skip the auto-browser-open entirely (useful when running as a background service):
REM set Shield__Launcher__OpenBrowser=false
